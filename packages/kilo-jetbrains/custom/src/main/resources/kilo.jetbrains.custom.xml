<!-- DMC Custom Module Descriptor -->
<!-- Registered as a split-mode module inside the DMC Kilo plugin. -->
<!-- This file is NOT part of upstream kilo-jetbrains. -->
<idea-plugin>

    <dependencies>
        <module name="kilo.jetbrains.shared"/>
        <module name="kilo.jetbrains.frontend"/>
    </dependencies>

    <actions>
        <group id="com.dmc.KiloActions">
            <action
                id="com.dmc.SendSelection"
                class="com.dmc.actions.SendSelectionAction"
                text="Send Selection to Kilo"
                description="Insert the selected code into the Kilo prompt"
                icon="AllIcons.Actions.Copy">
            </action>

            <action
                id="com.dmc.SendFile"
                class="com.dmc.actions.SendFileAction"
                text="Send File to Kilo"
                description="Insert the current file into the Kilo prompt"
                icon="AllIcons.Nodes.File">
            </action>

            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </group>

        <action
            id="com.dmc.ProblemFix"
            class="com.dmc.actions.KiloProblemFixAction"
            text="Kilo一键修复"
            description="将当前问题填充到 Kilo 输入框"
            icon="AllIcons.Actions.QuickfixBulb">
            <add-to-group group-id="ProblemsView.ToolWindow.TreePopup" anchor="last"/>
        </action>

        <action
            id="com.dmc.GenerateCommitMessage"
            class="com.dmc.actions.GenerateCommitMessageAction"
            text="Kilo 生成提交信息"
            description="读取勾选的文件变更，生成 Commit Message Prompt"
            icon="AllIcons.Actions.Preview">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
