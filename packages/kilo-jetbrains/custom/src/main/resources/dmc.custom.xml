<!-- DMC Custom Module Descriptor -->
<!-- Registered as a split-mode module inside the DMC Kilo plugin. -->
<!-- This file is NOT part of upstream kilo-jetbrains. -->
<idea-plugin>
    <id>com.dmc.kilo.custom</id>

    <!-- Depends on the main plugin's backend and frontend modules -->
    <dependencies>
        <dependency>ai.kilocode.jetbrains</dependency>
    </dependencies>

    <content>
        <module name="com.dmc.kilo.custom"/>
    </content>

    <extensions defaultExtensionNs="com.intellij">
        <!-- DMC application service -->
        <applicationService
            serviceImplementation="com.dmc.bridge.DmcBridgeService"
            serviceInterface="com.dmc.bridge.DmcBridge"/>
    </extensions>

    <actions>
        <!-- Right-click editor: send selection to Kilo conversation -->
        <action
            id="com.dmc.SendSelection"
            class="com.dmc.actions.SendSelectionAction"
            text="Send Selection to Kilo"
            description="Send the selected code to the current Kilo conversation">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- Right-click editor: send file to Kilo conversation -->
        <action
            id="com.dmc.SendFile"
            class="com.dmc.actions.SendFileAction"
            text="Send File to Kilo"
            description="Send the current file to the current Kilo conversation">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
